---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { CONTACT, SITE, getBrand, waLink, type Locale } from '../../data/site';
import { squidoctopus } from '../../data/pages/squidoctopus';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = squidoctopus(locale);
const brand = getBrand('squidoctopus');
const contact = CONTACT.squidoctopus;

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/squidoctopus/*.jpg', {
  eager: true,
});
const photo = (name: string) => files[`../../assets/photos/squidoctopus/${name}.jpg`]!.default;

const alt = (id: string, en: string) => (locale === 'id' ? id : en);

// Foto "squid" kiriman owner memperlihatkan sotong (cuttlefish): badan lebar
// dengan sirip mengelilingi seluruh badan. Alt text menyebutnya apa adanya.

const product = (name: string, rows: readonly (readonly string[])[]) => ({
  '@type': 'Product',
  name,
  description: c.meta.description,
  category: locale === 'id' ? 'Seafood beku' : 'Frozen seafood',
  countryOfOrigin: 'ID',
  brand: { '@type': 'Organization', name: SITE.legalName },
  additionalProperty: rows.map((r) => ({ '@type': 'PropertyValue', name: r[0], value: r.slice(1).join(' · ') })),
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    product(locale === 'id' ? 'Cumi-cumi Beku' : 'Frozen Squid', c.squid.rows),
    product(locale === 'id' ? 'Gurita Beku' : 'Frozen Octopus', c.octopus.rows),
  ],
};
---

<Base
  brand={brand}
  locale={locale}
  slug={brand.slug}
  title={c.meta.title}
  description={c.meta.description}
  links={[...c.nav]}
  contact={contact}
  waMessage={c.waMessage}
  schema={schema}
>
  <!-- HERO -->
  <section class="hero" data-surface="deep">
    <div class="hero-bg" aria-hidden="true">
      <Image src={photo('sotong-keranjang')} alt="" loading="eager" widths={[836]} />
    </div>
    <div class="hero-depth" aria-hidden="true"></div>

    <div class="shell hero-inner">
      <div class="hero-text">
        <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>
        <h1 class="hero-title" data-reveal style="--reveal-delay:80ms">{c.hero.title}</h1>
        <p class="hero-lead" data-reveal style="--reveal-delay:170ms">{c.hero.lead}</p>
        <div class="hero-actions" data-reveal style="--reveal-delay:260ms">
          <a class="btn btn-primary" href={waLink(contact.wa, c.waMessage)} target="_blank" rel="noopener">
            {c.hero.cta}
          </a>
          <a class="btn btn-ghost" href="#cumi">{c.hero.ctaSecond}</a>
        </div>
      </div>

      <dl class="highlights" data-reveal style="--reveal-delay:340ms">
        {
          c.highlights.map((h) => (
            <div class="highlight">
              <dt class="highlight-value num">
                {h.value}
                <span class="highlight-unit">{h.unit}</span>
              </dt>
              <dd class="highlight-label">{h.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- TENTANG -->
  <section class="section">
    <div class="shell intro-grid">
      <div data-reveal>
        <p class="eyebrow eyebrow-paper">{c.intro.eyebrow}</p>
        <h2 class="section-title">{c.intro.title}</h2>
        {c.intro.body.map((p) => <p class="section-lead">{p}</p>)}
      </div>
      <ul class="points">
        {
          c.intro.points.map((p) => (
            <li data-reveal data-reveal-group="poin">
              <span class="point-name">{p.name}</span>
              <span class="point-desc">{p.desc}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CUMI -->
  <section id="cumi" class="section section-tint">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow-paper">{c.squid.eyebrow}</p>
        <h2 class="section-title">{c.squid.title}</h2>
        <p class="latin">{c.squid.latin}</p>
        <p class="section-lead">{c.squid.lead}</p>
      </div>

      <div class="table-scroll" data-reveal>
        <table class="data-table wide">
          <thead>
            <tr>{c.squid.headers.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {
              c.squid.rows.map(([name, ...rest]) => (
                <tr>
                  <th scope="row">{name}</th>
                  {rest.map((v) => <td>{v}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="after-table" data-reveal>
        <h3 class="sub-title">{c.squid.qualityTitle}</h3>
        <ul class="ticks ticks-2col">
          {c.squid.quality.map((q) => <li>{q}</li>)}
        </ul>
      </div>

      <div class="photo-row" data-reveal>
        <figure class="photo">
          <Image src={photo('sotong-bersih-pasang')} alt={alt('Sotong utuh yang sudah dibersihkan', 'Whole cleaned cuttlefish')} widths={[620]} />
        </figure>
        <figure class="photo">
          <Image src={photo('sotong-beku')} alt={alt('Sotong utuh beku', 'Frozen whole cuttlefish')} widths={[620]} />
        </figure>
        <figure class="photo">
          <Image src={photo('sotong-satuan')} alt={alt('Sotong bersih di keranjang sortir', 'Cleaned cuttlefish in a sorting basket')} widths={[620]} />
        </figure>
      </div>
    </div>
  </section>

  <!-- GURITA -->
  <section id="gurita" class="section section-deep" data-surface="deep">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c.octopus.eyebrow}</p>
        <h2 class="section-title">{c.octopus.title}</h2>
        <p class="latin">{c.octopus.latin}</p>
        <p class="section-lead">{c.octopus.lead}</p>
      </div>

      <div class="table-scroll" data-reveal>
        <table class="data-table wide">
          <thead>
            <tr>{c.octopus.headers.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {
              c.octopus.rows.map(([name, ...rest]) => (
                <tr>
                  <th scope="row">{name}</th>
                  {rest.map((v) => <td>{v}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="octopus-foot">
        <p class="fine" data-reveal>{c.octopus.note}</p>
        <figure class="photo octopus-photo" data-reveal>
          <Image src={photo('gurita-tentakel')} alt={alt('Gurita beku dengan tentakel tersusun rapi', 'Frozen octopus with neatly arranged tentacles')} widths={[836]} />
        </figure>
      </div>
    </div>
  </section>

  <!-- SPESIFIKASI -->
  <section id="spesifikasi" class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow-paper">{c.specs.eyebrow}</p>
        <h2 class="section-title">{c.specs.title}</h2>
      </div>

      <div class="spec-grid">
        <div class="table-scroll" data-reveal>
          <table class="data-table">
            <thead>
              <tr>{c.specs.headers.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {
                c.specs.rows.map(([k, v]) => (
                  <tr>
                    <th scope="row">{k}</th>
                    <td>{v}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div data-reveal>
          <h3 class="options-title">{c.specs.optionsTitle}</h3>
          {
            [c.specs.processing, c.specs.packaging].map((group) => (
              <div class="option-group">
                <p class="option-label">{group.title}</p>
                <ul class="chips">
                  {group.items.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            ))
          }
          <p class="note-box">{c.specs.custom}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MUTU -->
  <section id="mutu" class="section section-tint">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow-paper">{c.quality.eyebrow}</p>
        <h2 class="section-title">{c.quality.title}</h2>
        <p class="section-lead">{c.quality.lead}</p>
      </div>

      <ol class="steps">
        {
          c.quality.steps.map((s, i) => (
            <li class="step" data-reveal data-reveal-group="mutu">
              <span class="step-num num">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-name">{s.name}</span>
              <span class="step-desc">{s.desc}</span>
            </li>
          ))
        }
      </ol>

      <div class="after-table" data-reveal>
        <h3 class="sub-title">{c.quality.paramsTitle}</h3>
        <ul class="ticks ticks-2col">
          {c.quality.params.map((p) => <li>{p}</li>)}
        </ul>
        <p class="fine">{c.quality.docNote}</p>
      </div>

      <div class="photo-row" data-reveal>
        <figure class="photo">
          <Image src={photo('proses-pembersihan')} alt={alt('Pembersihan di meja proses', 'Cleaning at the processing table')} widths={[620]} />
        </figure>
        <figure class="photo">
          <Image src={photo('sotong-wadah')} alt={alt('Produk ditata dalam wadah sebelum pembekuan', 'Product laid out in trays before freezing')} widths={[620]} />
        </figure>
        <figure class="photo">
          <Image src={photo('sotong-beku-tangan')} alt={alt('Pemeriksaan produk beku', 'Checking frozen product')} widths={[620]} />
        </figure>
      </div>
    </div>
  </section>

  <!-- KETENTUAN -->
  <section id="ketentuan" class="section section-deep" data-surface="deep">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{c.terms.eyebrow}</p>
        <h2 class="section-title">{c.terms.title}</h2>
      </div>

      <div class="terms-grid">
        <div class="table-scroll" data-reveal>
          <table class="data-table">
            <thead>
              <tr>{c.terms.headers.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {
                c.terms.rows.map(([k, v]) => (
                  <tr>
                    <th scope="row">{k}</th>
                    <td>{v}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div data-reveal>
          <h3 class="options-title">{c.terms.howTitle}</h3>
          <ol class="how">
            {
              c.terms.how.map((h, i) => (
                <li>
                  <span class="how-num num">{String(i + 1).padStart(2, '0')}</span>
                  {h}
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- PENAWARAN -->
  <section id="penawaran" class="section">
    <div class="shell quote-grid">
      <div data-reveal>
        <p class="eyebrow eyebrow-paper">{c.quote.eyebrow}</p>
        <h2 class="section-title">{c.quote.title}</h2>
        <p class="section-lead">{c.quote.lead}</p>

        <div class="quote-actions">
          <a class="btn btn-primary" href={waLink(contact.wa, c.waMessage)} target="_blank" rel="noopener">
            {c.quote.waCta} · {contact.waLabel}
          </a>
          <a class="btn btn-ghost" href={`mailto:${contact.email}`}>{c.quote.emailCta}</a>
        </div>
      </div>

      <ol class="checklist" data-reveal>
        {c.quote.checklist.map((item, i) => (
          <li>
            <span class="checklist-num num">{i + 1}</span>
            {item}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-tint">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow-paper">{c.faq.eyebrow}</p>
        <h2 class="section-title">{c.faq.title}</h2>
      </div>

      <div class="faq">
        {
          c.faq.items.map((item) => (
            <details class="faq-item" data-reveal data-reveal-group="faq">
              <summary>
                <span>{item.q}</span>
                <span class="faq-mark" aria-hidden="true" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: -4.5rem;
    padding-top: 4.5rem;
  }

  /* Cahaya yang meredup ke arah dasar laut: terang samar di atas,
     pekat di bawah, dengan satu pendar lilac di sisi kanan. */
  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55) saturate(0.25);
  }

  .hero-depth {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--color-deep) 92%, transparent) 0%,
        color-mix(in srgb, var(--color-deep) 70%, transparent) 55%,
        color-mix(in srgb, var(--color-deep) 40%, transparent) 100%
      ),
      radial-gradient(
        ellipse 55% 60% at 85% 30%,
        color-mix(in srgb, var(--color-accent) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 80% 45% at 30% -10%,
        color-mix(in srgb, var(--color-deep-3) 90%, transparent),
        transparent 70%
      ),
      linear-gradient(to top, var(--color-deep) 0%, transparent 40%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3.5rem;
    min-height: calc(100svh - var(--frame-h) - 4.5rem);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-text {
    max-width: 48rem;
  }

  .hero-title {
    margin-top: 1.1rem;
    font-size: var(--text-hero);
    line-height: var(--text-hero--line-height);
  }

  .hero-lead {
    margin-top: 1.5rem;
    max-width: 48ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-on-deep-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .highlight {
    padding: 1.35rem 1.25rem;
    background: color-mix(in srgb, var(--color-deep) 80%, transparent);
  }

  .highlight-value {
    font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.4rem);
    line-height: 1;
    color: var(--color-on-deep);
  }

  .highlight-unit {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .highlight-label {
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--color-on-deep-muted);
  }

  /* ---------- SECTION UMUM ---------- */
  .section {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }

  .section-deep {
    background: var(--color-deep);
  }

  .section-tint {
    background: color-mix(in srgb, var(--color-accent) 18%, var(--color-paper));
  }

  .section-head {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  /* Aksen lilac terlalu pucat untuk teks kecil di latar terang,
     jadi di permukaan terang label memakai emas brand. */
  .eyebrow-paper {
    color: var(--color-second);
  }

  .section-title {
    margin-top: 0.9rem;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
  }

  .section-lead {
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-muted);
  }

  [data-surface='deep'] .section-lead {
    color: var(--color-on-deep-muted);
  }

  .latin {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-muted);
  }

  [data-surface='deep'] .latin {
    color: var(--color-accent);
  }

  .sub-title,
  .options-title {
    margin-bottom: 1.25rem;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
  }

  .after-table {
    margin-top: 3.5rem;
  }

  .fine {
    margin-top: 1.5rem;
    max-width: 68ch;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  [data-surface='deep'] .fine {
    color: var(--color-on-deep-muted);
  }

  /* ---------- FOTO ---------- */
  .photo-row {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }

  .photo-row .photo {
    aspect-ratio: 4 / 5;
  }

  .octopus-foot {
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-top: 1rem;
  }

  .octopus-photo {
    aspect-ratio: 16 / 10;
  }

  /* ---------- TENTANG ---------- */
  .intro-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .points {
    display: grid;
    gap: 1px;
    background: var(--color-line-soft);
    border: 1px solid var(--color-line-soft);
  }

  .points li {
    display: grid;
    gap: 0.35rem;
    padding: 1.4rem 1.4rem;
    background: var(--color-paper-2);
  }

  .point-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-ink);
  }

  .point-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  /* ---------- TABEL ---------- */
  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  /* Tabel lima kolom digulir menyamping di layar sempit, bukan diremas. */
  .data-table.wide {
    min-width: 54rem;
  }

  .data-table th,
  .data-table td {
    text-align: left;
    vertical-align: top;
    padding: 1rem 1.25rem 1rem 0;
    border-bottom: 1px solid var(--color-line-soft);
    line-height: 1.5;
  }

  .data-table thead th {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-second);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
  }

  .data-table tbody th {
    font-weight: 500;
    color: var(--color-ink);
  }

  .data-table td {
    color: var(--color-muted);
  }

  [data-surface='deep'] .data-table th,
  [data-surface='deep'] .data-table td {
    border-bottom-color: var(--color-line);
  }

  [data-surface='deep'] .data-table thead th {
    color: var(--color-accent);
    border-bottom-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  [data-surface='deep'] .data-table tbody th {
    color: var(--color-on-deep);
  }

  [data-surface='deep'] .data-table td {
    color: var(--color-on-deep-muted);
  }

  /* ---------- DAFTAR ---------- */
  .ticks {
    display: grid;
    border-top: 1px solid var(--color-line-soft);
  }

  .ticks li {
    position: relative;
    padding-block: 0.8rem;
    padding-left: 1.4rem;
    font-size: 0.92rem;
    line-height: 1.55;
    border-bottom: 1px solid var(--color-line-soft);
    color: var(--color-ink);
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.2rem;
    width: 6px;
    height: 6px;
    background: var(--color-second);
    transform: rotate(45deg);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chips li {
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--color-ink);
    background: var(--color-paper-2);
  }

  .note-box {
    margin-top: 2rem;
    padding: 1.25rem 1.4rem;
    border-left: 2px solid var(--color-second);
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  /* ---------- SPESIFIKASI ---------- */
  .spec-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .option-group + .option-group {
    margin-top: 1.5rem;
  }

  .option-label {
    margin-bottom: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-second);
  }

  /* ---------- MUTU ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1px;
    background: var(--color-line-soft);
    border: 1px solid var(--color-line-soft);
  }

  .step {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.5rem 1.25rem;
    background: var(--color-paper-2);
  }

  .step-num {
    font-size: 1.5rem;
    color: var(--color-second);
  }

  .step-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-ink);
  }

  .step-desc {
    font-size: 0.82rem;
